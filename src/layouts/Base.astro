---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { type Lang, base, languages, localePath, useT } from '../i18n';
import shareImage from '../assets/tebeto/collage-wide.png';

interface Props {
  lang: Lang;
  route: '' | 'tebeto';
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const t = useT(lang);
const page = route === 'tebeto' ? 'tebeto' : 'home';

// Absolute URLs for link previews; only available once the site URL is known.
const canonical = Astro.site ? new URL(localePath(lang, route), Astro.site).href : undefined;
const share = Astro.site
  ? new URL((await getImage({ src: shareImage, width: 1200, format: 'jpg' })).src, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eae4da" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {share && <meta property="og:image" content={share} />}
    {share && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={localePath(l, route)} />
      ))
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} route={route} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
